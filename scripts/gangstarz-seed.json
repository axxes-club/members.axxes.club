      "type": "gangstarz-story",
      "content": {
        "anchor": "about",
        "eyebrow": "HOUSE MUSIC. HOMEGROWN.",
        "title": "A COLLECTIVE.\nA COMMUNITY.\nA FEELING.",
        "subtitle": "We love this city. We love this music. We\u2019re here to bring people together.",
        "text": "Founded in Charlotte in 2024 by Ian Kingston Smith, Gangstarz is a DJ collective built around a love for house music. Latin tech, deep grooves, funky cuts, and peak-hour tech house.\n\nFrom caf\u00e9 parties to late-night afters, we bring the DJs, sound, lighting, and the energy. Every event is produced by our team, with community at the center.",
        "image": "/media/collective.jpg",
        "alt": "Gangstarz house music community in Charlotte",
        "linkText": "Come find us on Instagram",
        "linkUrl": "https://www.instagram.com/gangstarz_clt/"
      },
      "settings": {},
      "sortOrder": 2,
      "isVisible": true
    },
