{
  "name": "members.axxes.club",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:push:force": "dotenv -e .env.local -- drizzle-kit push --force",
    "postbuild": "echo \"Skipping db push\"",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "version": "./scripts/version.sh",
    "release": "pnpm build && ./scripts/version.sh minor && git push origin main --tags",
    "release:major": "pnpm build && ./scripts/version.sh major && git push origin main --tags",
    "release:patch": "pnpm build && ./scripts/version.sh patch && git push origin main --tags",
    "matter:migrate": "node scripts/matter-migrate.mjs",
    "matter:templates": "node scripts/matter-seed-templates.mjs",
    "matter:demo": "node scripts/matter-demo.mjs",
    "matter:demo:clean": "node scripts/matter-demo.mjs --clean",
    "matter:catalog": "node scripts/matter-catalog.mjs",
    "matter:catalog:hide": "node scripts/matter-catalog.mjs --hide",
    "test:storage": "node --test scripts/gcs/*.check.mjs",
    "test:office-domain": "tsx --test tests/office-links-domain.test.ts",
    "test:organization-launch": "node --test tests/*.test.mjs",
    "test:public-tenants": "tsx --test tests/public-tenant-routes.test.ts tests/public-origin.test.ts",
    "test:website": "tsx --test tests/website/*.test.ts",
    "test:quota": "node --test scripts/storage/*.check.mjs",
    "test:commerce": "tsx --test tests/commerce/*.test.ts",
    "test:storage-billing": "tsx --test tests/storage-billing-catalog.test.ts",
    "test:platform-admin": "tsx --test tests/platform-admin/*.test.ts",
    "test:security": "node --test tests/safe-head.test.mjs tests/security-admission.test.mjs tests/security-webhook.test.mjs tests/security-credential.test.mjs tests/security-account.test.mjs tests/security-account-policy.test.mjs && node --import tsx --test tests/security-signup.test.ts tests/security-smtp.test.ts"
  },
